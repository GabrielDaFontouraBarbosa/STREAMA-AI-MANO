# Copie este arquivo para .env (nesta mesma pasta) e preencha.

# Endereço do site. Comece com o localhost; depois que o túnel subir, troque
# pelo endereço https://....trycloudflare.com e rode: docker compose up -d app
PUBLIC_URL=http://localhost:8080

# Qualquer texto grande e aleatório (ex.: bata no teclado uns 40 caracteres)
BETTER_AUTH_SECRET=

# Token do bot: discord.com/developers/applications → seu app → Bot → Reset Token
DISCORD_TOKEN=

# Opcionais
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
