# ── Blink — variáveis de ambiente ───────────────────────────
# Local: copie para .env (na raiz) e rode `cd server && npm run dev`.
# Railway: configure em Variables do serviço.

PORT=8080

# Postgres. No Railway use a referência: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/blink
# PGSSL=1   # força TLS (ex.: usar a URL pública do Railway de fora)

# Better Auth — gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL pública do app (no Railway é detectada via RAILWAY_PUBLIC_DOMAIN)
# PUBLIC_URL=https://blink-production.up.railway.app
# Outras origens permitidas (separadas por vírgula), ex.: domínio próprio
# TRUSTED_ORIGINS=https://blink.app

# Cloudflare Realtime TURN (dash.cloudflare.com → Realtime → TURN Server)
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# TURN_CREDENTIAL_TTL=21600

# Web Push — gere com: cd server && npm run vapid:keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com
