# ── Blink — variáveis de ambiente ───────────────────────────
# Local: copie para .env (na raiz) e rode `cd server && npm run dev`.
# Railway: configure em Variables do serviço.

PORT=8080

# Postgres. No Railway use a referência: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/blink
# PGSSL=1   # força TLS (ex.: usar a URL pública do Railway de fora)

# Better Auth — gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL pública do app (no Railway é detectada via RAILWAY_PUBLIC_DOMAIN)
# PUBLIC_URL=https://blink-production.up.railway.app
# Outras origens permitidas (separadas por vírgula), ex.: domínio próprio.
# OBRIGATÓRIO quando o acesso é por túnel (Cloudflare): sem a origem do túnel
# aqui, o login responde 403.
# TRUSTED_ORIGINS=http://localhost:8080,https://SUA-URL.trycloudflare.com

# Cloudflare Tunnel com domínio fixo (só o profile "named" do docker compose)
# CLOUDFLARE_TUNNEL_TOKEN=

# Cloudflare Realtime TURN (dash.cloudflare.com → Realtime → TURN Server)
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# TURN_CREDENTIAL_TTL=21600

# Web Push — gere com: cd server && npm run vapid:keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# Mini Blink (bot do Discord) — mesmo valor do mini-blink/.env. Liga a tela
# dentro do Discord (Activity). Gere com:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# MINI_BLINK_SECRET=

# Bot do Discord rodando DENTRO do Blink (24h no Render). Com DISCORD_TOKEN
# definido, o bot liga junto com o site. Não rode o bot no PC ao mesmo tempo.
# DISCORD_TOKEN=
# DISCORD_CLIENT_ID=
# DISCORD_GUILD_ID=
# Canal onde o botão "Mandar no Discord" posta as lives
# (botão direito no canal → Copiar ID do canal)
# DISCORD_LIVE_CHANNEL_ID=

# "Entrar com Discord" e "Conectar Discord": Discord Developer Portal → OAuth2 → Client Secret.
# Redirect a cadastrar lá: <PUBLIC_URL>/api/auth/callback/discord
# DISCORD_CLIENT_SECRET=

# Link de doação/apoio no rodapé (Livepix, Ko-fi, Apoia.se…). Precisa ser https.
# SUPPORT_URL=https://livepix.gg/seu-usuario
