# ── Mini Blink — variáveis de ambiente ──────────────────────
# Copie para .env (nesta pasta) e preencha.

# Discord Developer Portal → sua aplicação → Bot → Reset Token
DISCORD_TOKEN=
# Discord Developer Portal → sua aplicação → General Information → Application ID
DISCORD_CLIENT_ID=
# Opcional: ID do seu servidor. Com ele os comandos aparecem na hora;
# sem ele são globais e podem levar até 1h para aparecer.
# (Discord → Configurações → Avançado → Modo desenvolvedor; botão direito no servidor → Copiar ID)
DISCORD_GUILD_ID=

# Endereço do Blink no ar (sem barra no final)
BLINK_URL=https://seu-blink.onrender.com

# De quanto em quanto tempo checar se a live acabou (segundos)
# CHECK_INTERVAL=20

# Tela dentro do Discord (Activity). O MESMO valor vai no Blink (variável
# MINI_BLINK_SECRET do servidor). Gere com:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MINI_BLINK_SECRET=
# MINI_BLINK_ACTIVITY=0   # desliga o botão "Assistir aqui no Discord"
