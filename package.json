{
  "name": "blink",
  "version": "1.0.0",
  "description": "Blink \u2014 sua tela ao vivo, direto do navegador (WebRTC)",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "cd server && npm start",
    "dev": "cd server && npm run dev",
    "install-server": "cd server && npm install",
    "test": "npm run test:unit && npm --prefix mini-blink test",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.e2e.js\""
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
